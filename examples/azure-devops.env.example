# This is parsed as bounded NAME=VALUE records, not as shell syntax.
AZURE_DEVOPS_PAT=replace-with-a-real-pat

# Required only when the Azure provider webhook block is configured.
AZURE_DEVOPS_WEBHOOK_USERNAME=replace-with-a-webhook-username
AZURE_DEVOPS_WEBHOOK_PASSWORD=replace-with-a-webhook-password

CODEX_HOME=/var/lib/ensemble/codex
